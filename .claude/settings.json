{
  "permissions": {
    "allow": [
      "Bash(*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(sudo rm:*)",
      "Bash(cat ~/.ciq/*)",
      "Bash(cat *developer_key*)",
      "Bash(connect-iq-sdk-manager login:*)",
      "Read(~/.ciq/**)",
      "Read(~/.connect-iq-sdk-manager/**)"
    ],
    "ask": [
      "Bash(git commit:*)"
    ]
  }
}
